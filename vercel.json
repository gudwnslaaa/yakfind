{
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/sitemap.js": {
      "maxDuration": 60
    },
    "api/region-page.js": {
      "maxDuration": 60
    },
    "api/drug-page.js": {
      "maxDuration": 30
    },
    "api/pill-index.js": {
      "maxDuration": 60
    },
    "api/pill.js": {
      "maxDuration": 60
    },
    "api/dur-check.js": {
      "maxDuration": 30
    },
    "api/topic-page.js": {
      "maxDuration": 30
    },
    "api/er.js": {
      "maxDuration": 30
    },
    "api/recall.js": {
      "maxDuration": 30
    },
    "api/clinic.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/holiday",
      "destination": "/holiday.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/travel",
      "destination": "/travel.html"
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    },
    {
      "source": "/mybox",
      "destination": "/mybox.html"
    },
    {
      "source": "/scan",
      "destination": "/scan.html"
    },
    {
      "source": "/moonlight",
      "destination": "/api/clinic?mode=page"
    },
    {
      "source": "/clinic",
      "destination": "/clinic.html"
    },
    {
      "source": "/recall",
      "destination": "/api/recall?view=page"
    },
    {
      "source": "/er",
      "destination": "/er.html"
    },
    {
      "source": "/symptom/:name",
      "destination": "/api/topic-page?type=symptom&name=:name"
    },
    {
      "source": "/symptom",
      "destination": "/api/topic-page?type=symptom"
    },
    {
      "source": "/ingredient/:name",
      "destination": "/api/topic-page?type=ingredient&name=:name"
    },
    {
      "source": "/ingredient",
      "destination": "/api/topic-page?type=ingredient"
    },
    {
      "source": "/disposal",
      "destination": "/disposal.html"
    },
    {
      "source": "/pill",
      "destination": "/pill.html"
    },
    {
      "source": "/check",
      "destination": "/check.html"
    },
    {
      "source": "/convenience",
      "destination": "/convenience.html"
    },
    {
      "source": "/drug/:seq",
      "destination": "/api/drug-page?seq=:seq"
    },
    {
      "source": "/pharmacy",
      "destination": "/api/region-page"
    },
    {
      "source": "/pharmacy/:sido",
      "destination": "/api/region-page?sido=:sido"
    },
    {
      "source": "/pharmacy/:sido/:gu",
      "destination": "/api/region-page?sido=:sido&gu=:gu"
    },
    {
      "source": "/sitemaps/:type.xml",
      "destination": "/api/sitemap?type=:type"
    }
  ]
}